{
  "name": "RedeemCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The code string users enter (e.g. 'COOL_GAMES')"
    },
    "label": {
      "type": "string",
      "description": "Admin-facing description of what this code does"
    },
    "rewardType": {
      "type": "string",
      "enum": [
        "pet",
        "feature_unlock",
        "food_item",
        "xp",
        "coins",
        "title",
        "onepassplus"
      ],
      "description": "What kind of reward this code gives. 'title' unlocks the exact title text in rewardData.title. 'onepassplus' grants 1Pass Plus \u2014 permanent unless rewardData.seasons is set \u2014 and can only be created by a super admin."
    },
    "rewardData": {
      "type": "object",
      "description": "Reward payload. For pet: {petId} \u2014 a built-in pet id or 'custom_<CustomPet id>'. For title: {title} \u2014 the exact title text to unlock. For feature_unlock: {feature: 'games'|'shop'|'market'|'pets'|'battlePass'|'kitchen'}. For food_item: {itemId, quantity}. For xp: {amount}. For coins: {amount}. For onepassplus: no payload grants permanent 1Pass Plus; {seasons: n} grants n season(s) starting from the current 1Pass season (1 = this season only) by setting plusSeasonsGranted and plusExpiresAt."
    },
    "maxUses": {
      "type": "number",
      "description": "Max total redemptions (null = unlimited)"
    },
    "usedBy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of userProfile IDs who have redeemed this code"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiry date"
    }
  },
  "required": [
    "code",
    "rewardType"
  ]
}