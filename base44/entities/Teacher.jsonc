{
  "name": "Teacher",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Teacher display name"
    },
    "subject": {
      "type": "string",
      "description": "Subject slug this teacher teaches \u2014 'math', 'reading', or a custom Subject entity slug"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Whether this teacher appears in selection lists"
    },
    "sortOrder": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name",
    "subject"
  ]
}