{
  "name": "DMThread",
  "type": "object",
  "properties": {
    "studentProfileId": {
      "type": "string",
      "description": "UserProfile ID of the student side. This is the student's stable identity and is never re-pointed."
    },
    "studentUsername": {
      "type": "string",
      "description": "Display snapshot of the student's username (presentation only)"
    },
    "contactId": {
      "type": "string",
      "description": "DMContact ID this conversation is addressed to. Resolves to the recipient via the contact's adminProfileId."
    },
    "contactUsername": {
      "type": "string",
      "description": "Display snapshot of the contact name shown to students (presentation only \u2014 never used for routing)"
    },
    "recipientProfileId": {
      "type": "string",
      "description": "UserProfile ID of the contact's linked recipient, snapshotted when the thread was created from a verified contact link. Authoritative for routing; reassigning a contact does not move existing conversations. Null on threads whose contact had no verified link when they were created."
    },
    "messages": {
      "type": "array",
      "description": "Legacy embedded message log. Messages sent from the messaging UI are stored as DMMessage records instead, so two people sending at once cannot overwrite each other. Both sources are merged (and deduplicated by operationId) when a conversation is displayed.",
      "items": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "description": "student | admin | bot | system"
          },
          "senderName": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "giftData": {
            "type": "object"
          },
          "operationId": {
            "type": "string"
          }
        }
      }
    },
    "lastMessageAt": {
      "type": "string",
      "format": "date-time"
    },
    "hasUnreadAdmin": {
      "type": "boolean",
      "default": false,
      "description": "Unread for the recipient side (contact / admin). On an escalated thread this means a support admin has not read the student's latest message."
    },
    "hasUnreadStudent": {
      "type": "boolean",
      "default": false
    },
    "byteConvId": {
      "type": "string"
    },
    "isEscalated": {
      "type": "boolean",
      "default": false,
      "description": "Byte forwarded to a real admin"
    },
    "escalatedToAdmin": {
      "type": "string",
      "description": "Which admin username it was forwarded to"
    },
    "escalationSummary": {
      "type": "string",
      "description": "Byte's summary of the issue before escalating"
    },
    "supportStatus": {
      "type": "string",
      "enum": [
        "waiting",
        "replied",
        "resolved"
      ],
      "description": "Support handoff state. waiting = sent and no human reply yet, replied = a support admin answered, resolved = closed by a support admin. Threads escalated before this field existed fall back to waiting."
    },
    "supportDetails": {
      "type": "string",
      "description": "Optional extra details the student added in the handoff preview"
    },
    "supportTranscript": {
      "type": "array",
      "description": "Snapshot of the Byte conversation shared with support admins at handoff time. Text only \u2014 never PINs, tokens or unrelated account fields.",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "student | byte"
          },
          "text": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "supportRequestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the student first sent (or re-sent) this request. Kept stable across updates."
    },
    "supportOperationId": {
      "type": "string",
      "description": "Stable id of the submitted handoff, so a repeated tap or retry never creates a second request"
    },
    "supportAssignedAdminProfileId": {
      "type": "string",
      "description": "UserProfile ID of the support admin who claimed or was assigned this request"
    },
    "supportAssignedAdminUsername": {
      "type": "string",
      "description": "Display snapshot of the assigned support admin"
    },
    "supportResolvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "supportResolvedByUsername": {
      "type": "string"
    }
  },
  "required": [
    "studentProfileId",
    "studentUsername",
    "contactId",
    "contactUsername"
  ]
}