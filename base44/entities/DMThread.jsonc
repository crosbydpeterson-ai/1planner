{
  "name": "DMThread",
  "type": "object",
  "properties": {
    "studentProfileId": {
      "type": "string",
      "description": "UserProfile ID of the student side. This is the student's stable identity and is never re-pointed."
    },
    "studentUsername": {
      "type": "string",
      "description": "Display snapshot of the student's username (presentation only)"
    },
    "contactId": {
      "type": "string",
      "description": "DMContact ID this conversation is addressed to. Resolves to the recipient via the contact's adminProfileId."
    },
    "contactUsername": {
      "type": "string",
      "description": "Display snapshot of the contact name shown to students (presentation only \u2014 never used for routing)"
    },
    "recipientProfileId": {
      "type": "string",
      "description": "UserProfile ID of the contact's linked recipient, snapshotted when the thread was created from a verified contact link. Authoritative for routing; reassigning a contact does not move existing conversations. Null on threads whose contact had no verified link when they were created."
    },
    "messages": {
      "type": "array",
      "description": "Legacy embedded message log. Messages sent from the messaging UI are stored as DMMessage records instead, so two people sending at once cannot overwrite each other. Both sources are merged (and deduplicated by operationId) when a conversation is displayed.",
      "items": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "description": "student | admin | bot | system"
          },
          "senderName": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "giftData": {
            "type": "object"
          },
          "operationId": {
            "type": "string"
          }
        }
      }
    },
    "lastMessageAt": {
      "type": "string",
      "format": "date-time"
    },
    "hasUnreadAdmin": {
      "type": "boolean",
      "default": false,
      "description": "Unread for the recipient side (contact / admin)"
    },
    "hasUnreadStudent": {
      "type": "boolean",
      "default": false
    },
    "byteConvId": {
      "type": "string"
    },
    "isEscalated": {
      "type": "boolean",
      "default": false,
      "description": "Byte forwarded to a real admin"
    },
    "escalatedToAdmin": {
      "type": "string",
      "description": "Which admin username it was forwarded to"
    },
    "escalationSummary": {
      "type": "string",
      "description": "Byte's summary of the issue before escalating"
    }
  },
  "required": [
    "studentProfileId",
    "studentUsername",
    "contactId",
    "contactUsername"
  ]
}