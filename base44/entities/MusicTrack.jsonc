{
  "name": "MusicTrack",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song title"
    },
    "description": {
      "type": "string",
      "description": "Optional description shown on the card"
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "upload",
        "youtube"
      ],
      "description": "Whether this track is an uploaded audio file or a YouTube link"
    },
    "audioFileUri": {
      "type": "string",
      "description": "Private file URI returned by UploadPrivateFile (for sourceType=upload)"
    },
    "youtubeUrl": {
      "type": "string",
      "description": "Full YouTube watch URL (for sourceType=youtube)"
    },
    "startAtSeconds": {
      "type": "number",
      "default": 0,
      "description": "Where playback begins, in seconds. Everything before it is skipped, so an intro or a spoken preamble is never heard. 0 starts at the top."
    },
    "skipSegments": {
      "type": "array",
      "default": [],
      "description": "Parts of the song that are jumped over during playback, in seconds from the start of the file. Each part needs an end later than its start.",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
            "description": "First second of the part to cut, e.g. 35"
          },
          "end": {
            "type": "number",
            "description": "Second where the song picks up again, e.g. 70"
          }
        },
        "required": [
          "start",
          "end"
        ]
      }
    },
    "coverImageUri": {
      "type": "string",
      "description": "Private file URI for the cover art, signed on display"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Only active tracks show up for students"
    },
    "isSeasonExclusive": {
      "type": "boolean",
      "default": false,
      "description": "If true, the track is only visible to users who unlocked it via a 1Pass song/playlist reward (admins always see it). Used to gate songs behind 1Pass."
    },
    "assignedProfileIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "UserProfile IDs this track is assigned to. Empty = visible to everyone (ignored when isSeasonExclusive is true)."
    },
    "lockedProfileIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "UserProfile IDs who cannot see this track"
    },
    "lockedClassKeys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Class keys (e.g. 'math:<teacherId>') that cannot see this track"
    },
    "createdBy": {
      "type": "string",
      "description": "Admin username who created the track"
    }
  },
  "required": [
    "title",
    "sourceType"
  ]
}