{
  "name": "HelperCard",
  "type": "object",
  "properties": {
    "number": {
      "type": "string",
      "description": "Card number exactly as printed and encoded in the QR code. Always text, so leading characters survive."
    },
    "numberKey": {
      "type": "string",
      "description": "Normalized card number (no spaces, dashes or dots, lowercase) used to match a scanned or typed card."
    },
    "nickname": {
      "type": "string",
      "description": "Admin-facing name, e.g. 'Front desk helper card'"
    },
    "adminProfileId": {
      "type": "string",
      "description": "UserProfile id of the admin this card belongs to. Quick Help refuses the card if that account is no longer an admin."
    },
    "adminUsername": {
      "type": "string",
      "description": "Display snapshot of the admin who owns the card"
    },
    "actions": {
      "type": "object",
      "description": "Which Quick Help actions this card may confirm. Switch Account is off by default.",
      "properties": {
        "fixXp": {
          "type": "boolean",
          "default": false
        },
        "grantReward": {
          "type": "boolean",
          "default": false
        },
        "giftSong": {
          "type": "boolean",
          "default": false,
          "description": "Lets the admin add one song from the library to the student's collection."
        },
        "resetPasscode": {
          "type": "boolean",
          "default": false
        },
        "switchAccount": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "rewardPresets": {
      "type": "array",
      "default": [],
      "description": "The short list of rewards this card is allowed to grant.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "What the admin sees on the reward tile, e.g. '+50 XP'"
          },
          "type": {
            "type": "string",
            "enum": [
              "xp",
              "coins"
            ]
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "type",
          "amount"
        ]
      }
    },
    "reward": {
      "type": "object",
      "description": "Optional bonus this card hands the student it helps the first time it is used on that student. Same payload the magic cards and redeem codes use, so it grants through the same rules.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "pet",
            "onepassplus",
            "xp",
            "coins",
            "title"
          ]
        },
        "petId": {
          "type": "string",
          "description": "Built-in pet id, or 'custom_<CustomPet id>'"
        },
        "amount": {
          "type": "number",
          "description": "XP or coin amount"
        },
        "title": {
          "type": "string",
          "description": "Exact title text for a title reward"
        },
        "label": {
          "type": "string",
          "description": "What the admin and student see, e.g. '+50 XP' or '\ud83d\udc3e Math Cat'"
        }
      }
    },
    "rewardGrantedProfileIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Students who already received this card's bonus, so one card gives its bonus once per student."
    },
    "design": {
      "type": "object",
      "description": "Helper Card Studio look only. Kept apart from the sign-in fields (number, admin, allowed actions), so changing the artwork never changes what the card may do.",
      "properties": {
        "templateId": {
          "type": "string",
          "description": "grid | passport | holo | starry | aurora | synth | ocean | dots | lava | swirl | ice | comic"
        },
        "themeId": {
          "type": "string",
          "description": "CardTheme id when the look came from a saved theme"
        },
        "themeName": {
          "type": "string",
          "description": "Name snapshot of the saved theme used for this card"
        },
        "colors": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string"
            },
            "secondary": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "ink": {
              "type": "string"
            }
          }
        },
        "textColor": {
          "type": "string",
          "description": "Overrides the template's default text colour. Empty falls back to the template."
        },
        "backgroundUri": {
          "type": "string",
          "description": "URL of AI-generated (or other) background artwork. Card numbers are never sent anywhere."
        },
        "sticker": {
          "type": "string",
          "description": "Emoji sticker printed on the card"
        },
        "displayName": {
          "type": "string",
          "description": "Name printed large on the card front. Falls back to the card's nickname."
        }
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "A disabled card is refused when scanned and checked again at confirmation."
    },
    "disabledAt": {
      "type": "string",
      "format": "date-time"
    },
    "disabledBy": {
      "type": "string",
      "description": "Admin username who disabled or replaced the card"
    },
    "replacedByCardId": {
      "type": "string",
      "description": "HelperCard id that replaced this one, when it was retired"
    },
    "note": {
      "type": "string",
      "description": "Optional admin note, e.g. who carries this card"
    }
  },
  "required": [
    "number",
    "numberKey",
    "adminProfileId"
  ]
}