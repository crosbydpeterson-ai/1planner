{
  "name": "PawSpellRoom",
  "type": "object",
  "properties": {
    "roomCode": {
      "type": "string",
      "description": "4-digit room code"
    },
    "hostProfileId": {
      "type": "string"
    },
    "hostUsername": {
      "type": "string"
    },
    "guestProfileId": {
      "type": "string"
    },
    "guestUsername": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "active",
        "finished"
      ],
      "default": "waiting"
    },
    "board": {
      "type": "array",
      "description": "8x8 board state"
    },
    "currentTurn": {
      "type": "string",
      "default": "w"
    },
    "lastMove": {
      "type": "object"
    },
    "gems": {
      "type": "array",
      "description": "Crystal gem positions and collection status"
    },
    "gemsCollected": {
      "type": "object",
      "description": "{ w: count, b: count }"
    },
    "winner": {
      "type": "string"
    },
    "winReason": {
      "type": "string"
    },
    "castlingRights": {
      "type": "object"
    },
    "hostEquippedSkins": {
      "type": "object"
    },
    "guestEquippedSkins": {
      "type": "object"
    },
    "abilitiesUsed": {
      "type": "object",
      "description": "{ w: true/false, b: true/false } \u2014 whether each side has used their ability"
    },
    "abilityEffects": {
      "type": "object",
      "description": "Active ability effects on the board \u2014 frozen squares, blocked files, burn traps etc"
    },
    "pendingAbility": {
      "type": "object",
      "description": "Ability waiting for player to select a target { side, category, pieceType, abilityName }"
    },
    "winConditionOverride": {
      "type": "string",
      "description": "Override normal win condition e.g. crystal_fortress_5gems or entropy_random"
    }
  },
  "required": [
    "roomCode",
    "hostProfileId"
  ]
}