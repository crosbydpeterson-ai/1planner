{
  "name": "MagicCard",
  "type": "object",
  "properties": {
    "number": {
      "type": "string",
      "description": "Card number exactly as printed. Always text so leading zeros survive."
    },
    "numberKey": {
      "type": "string",
      "description": "Normalized card number (no spaces, dashes or dots, lowercase) used to match a scanned or typed card."
    },
    "nickname": {
      "type": "string",
      "description": "Friendly name shown in the admin list, e.g. 'Blue arcade card'"
    },
    "profileId": {
      "type": "string",
      "description": "UserProfile id this card opens"
    },
    "profileUsername": {
      "type": "string",
      "description": "Display snapshot of the linked account"
    },
    "pinHash": {
      "type": "string",
      "description": "Encoded optional card PIN. Empty means the card opens its account in one scan."
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Disabled cards are ignored at the login screen"
    },
    "successSound": {
      "type": "string",
      "description": "Chime played when this card is recognised. A built-in sound id, or 'custom' when successSoundUrl holds an uploaded sound."
    },
    "successSoundUrl": {
      "type": "string",
      "description": "Public URL of an uploaded chime. Played instead of the built-in sound when set."
    },
    "rejectSound": {
      "type": "string",
      "description": "Sound played when this card is refused (disabled card or wrong PIN). A built-in id, or 'custom' when rejectSoundUrl holds an uploaded sound."
    },
    "rejectSoundUrl": {
      "type": "string",
      "description": "Public URL of an uploaded refusal sound. Played instead of the built-in sound when set."
    },
    "design": {
      "type": "object",
      "description": "Magic Card Studio look only. Kept apart from the sign-in fields (number, PIN, linked profile, enabled), so changing the artwork never changes how the card logs in.",
      "properties": {
        "templateId": {
          "type": "string",
          "description": "grid | passport | holo | starry | aurora | synth | ocean | dots | lava | swirl | ice | comic"
        },
        "themeId": {
          "type": "string",
          "description": "CardTheme id when the look came from a saved theme"
        },
        "themeName": {
          "type": "string",
          "description": "Name snapshot of the saved theme used for this card"
        },
        "colors": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string"
            },
            "secondary": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "ink": {
              "type": "string"
            }
          }
        },
        "textColor": {
          "type": "string",
          "description": "Overrides the template's default text colour. Empty falls back to the template."
        },
        "backTextColor": {
          "type": "string",
          "description": "Text colour printed on the card back (number and labels). Empty keeps the theme's text colour."
        },
        "barcodeColor": {
          "type": "string",
          "description": "Bar colour of the card back's Code 39 barcode, printed on a white plate. Empty uses near-black."
        },
        "backgroundUri": {
          "type": "string",
          "description": "URL of the AI-generated (or other) background artwork. Card numbers and PINs are never sent anywhere."
        },
        "sticker": {
          "type": "string",
          "description": "Emoji sticker printed on the front"
        },
        "petId": {
          "type": "string",
          "description": "Owned pet shown on the front (display only)"
        },
        "petEmoji": {
          "type": "string"
        },
        "petImageUrl": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "description": "Name printed on the card front"
        }
      }
    }
  },
  "required": [
    "number",
    "numberKey",
    "profileId"
  ]
}