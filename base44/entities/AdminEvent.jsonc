{
  "name": "AdminEvent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Event name"
    },
    "type": {
      "type": "string",
      "enum": [
        "bubble_pop",
        "balloon_pop",
        "fusion_lab",
        "pet_food",
        "xp_boost",
        "mystery_box",
        "confetti",
        "pinata",
        "chaos_night"
      ],
      "description": "Event type"
    },
    "isActive": {
      "type": "boolean",
      "default": false
    },
    "musicTrack": {
      "type": "string",
      "enum": [
        "none",
        "upbeat",
        "spooky",
        "epic",
        "chill",
        "chaos",
        "disco",
        "battle"
      ],
      "default": "none",
      "description": "Background music theme that plays for all users during this event"
    },
    "musicEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether music plays during this event"
    },
    "config": {
      "type": "object",
      "properties": {
        "bubbleCount": {
          "type": "number"
        },
        "eggChance": {
          "type": "number"
        },
        "xpBoostMultiplier": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "totalHits": {
          "type": "number"
        },
        "currentHits": {
          "type": "number",
          "default": 0
        },
        "prizePool": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "theme": {
          "type": "string"
        },
        "pinataHits": {
          "type": "number"
        }
      }
    },
    "startTime": {
      "type": "string",
      "format": "date-time"
    },
    "endTime": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "type"
  ]
}